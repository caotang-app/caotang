{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM for `Blob` and the Web Crypto types the emitter uses; no DOM runs at
    // test time (the vitest environment is node).
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
