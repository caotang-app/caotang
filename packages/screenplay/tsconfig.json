{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is here for `Blob` and `TextEncoder`, which the renderers' `emit` returns and uses.
    // Nothing here runs in a browser.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
