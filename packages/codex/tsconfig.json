{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is here for `lib.dom`'s types only. This package imports types from
    // `@caotang/store`, and the store's sources reference IndexedDB interfaces, so
    // the type-check program pulls them in. The same reason `packages/editor` and
    // `packages/store` carry this lib; nothing here runs in a browser.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
