{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is here for `lib.dom` types only — the audit is headless and runs in
    // vitest's `node` environment (the root config's default, and M0's exit
    // criterion is "mock provider importable headless"). Tiptap's extension
    // definitions reference DOM interfaces at the type level; the corpus itself
    // never mounts a view, so nothing here needs a DOM at runtime.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "bundle-entry.ts"]
}
